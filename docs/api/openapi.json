    "/api/v1/dossiers": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "Get Dossiers",
        "description": "A page of item cards, sorted by name (by type, then name, when grouped by type).",
        "operationId": "get_dossiers_api_v1_dossiers_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "The search language, e.g. `donut env:starfield tag:food`",
              "default": "",
              "title": "Query"
            },
            "description": "The search language, e.g. `donut env:starfield tag:food`"
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "product, type or all; searches, type, collection and Unidentified views always list all, as the window does",
              "default": "product",
              "title": "Group"
            },
            "description": "product, type or all; searches, type, collection and Unidentified views always list all, as the window does"
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only assets with a live entry in this environment",
              "title": "Environment"
            },
            "description": "Only assets with a live entry in this environment"
          },
          {
            "name": "container",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only assets with a live entry in this container",
              "title": "Container"
            },
            "description": "Only assets with a live entry in this container"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this dossier type and its subtypes",
              "title": "Type"
            },
            "description": "Only this dossier type and its subtypes"
          },
          {
            "name": "parent",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One product's contents, by its uid",
              "title": "Parent"
            },
            "description": "One product's contents, by its uid"
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One collection's members, by its uid",
              "title": "Collection"
            },
            "description": "One collection's members, by its uid"
          },
          {
            "name": "unidentified",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only Unidentified assets",
              "default": false,
              "title": "Unidentified"
            },
            "description": "Only Unidentified assets"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
