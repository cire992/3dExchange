{
  "openapi": "3.1.0",
  "info": {
    "title": "Exchange",
    "description": "The local API of the Exchange service, for the desktop shell's Workspace window.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Health",
        "description": "Whether the service is up. Needs no token and reveals nothing about the library.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
